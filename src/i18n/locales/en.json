{
  "money.usd.zero": "$0",
  "money.usd.b": "${value, number, ::.##}B",
  "money.usd.m": "${value, number, ::.#}M",
  "money.usd.k": "${value, number, ::integer}K",
  "money.short.zero": "0",
  "money.short.b": "{value, number, ::.##}B",
  "money.short.m": "{value, number, ::.#}M",
  "money.short.k": "{value, number, ::integer}K"
}
