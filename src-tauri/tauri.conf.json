{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Deal Atlas",
  "version": "0.0.0",
  "identifier": "partners.tmss.dealatlas",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Deal Atlas",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'"
    }
  },
  "bundle": {
    "active": false
  }
}
